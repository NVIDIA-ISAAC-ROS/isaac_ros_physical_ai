<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>isaac_ros_unitree_g1_teleop_bringup</name>
  <version>4.4.0</version>
  <description>High-level teleop launch file for Unitree G1: agile locomotion + bimanual IK + finger control with interactive marker or XR teleop input.</description>
  <maintainer email="isaac-ros-maintainers@nvidia.com">Isaac ROS Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Dependencies -->
  <exec_depend>unitree_g1_bringup</exec_depend>
  <exec_depend>isaac_ros_cumotion_controllers</exec_depend>
  <exec_depend>isaac_ros_teleop</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
