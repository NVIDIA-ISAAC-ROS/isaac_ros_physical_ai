<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>isaac_ros_unitree_g1_cloud_control_bringup</name>
  <version>4.6.0</version>
  <description>
    Top-level bringup for Unitree G1 humanoid cloud control: combines the
    unitree_g1_bringup inference graph (AGILE + GR00T), humanoid task action
    server, GR00T output gate, VDA5050 mission client, MQTT bridge, and nav2.
    On real hardware, optionally adds a camera (RealSense D435 by default, OAK
    also supported) + VSLAM + VGL for visual localization
    (enable_camera_localization launch arg), plus optional nvblox 3D
    reconstruction for navigation (enable_nvblox).
  </description>
  <maintainer email="isaac-ros-maintainers@nvidia.com">Isaac ROS Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>unitree_g1_bringup</exec_depend>
  <exec_depend>isaac_ros_unitree_g1_gr00t</exec_depend>
  <exec_depend>isaac_ros_humanoid_task_server</exec_depend>
  <exec_depend>isaac_ros_vda5050_client_bringup</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <!-- Camera localization (VSLAM + VGL) and optional nvblox 3D reconstruction -->
  <exec_depend>isaac_ros_launch_utils</exec_depend>
  <exec_depend>isaac_ros_visual_slam</exec_depend>
  <exec_depend>isaac_ros_visual_global_localization</exec_depend>
  <exec_depend>isaac_ros_visual_mapping</exec_depend>
  <exec_depend>isaac_ros_image_proc</exec_depend>
  <exec_depend>depthai_ros_driver</exec_depend>
  <exec_depend>nvblox_ros</exec_depend>
  <exec_depend>nvblox_examples_bringup</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
